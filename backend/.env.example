# Copy this file to .env and fill in real values before running locally.

ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-long-random-secret
MIN_PASSWORD_LENGTH=8
SECURE_COOKIES=false

# --- Database ---
# Local dev (no MySQL required):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Production / Docker Compose:
# DATABASE_URL=mysql+aiomysql://raguser:ragpass@localhost:3306/ragdb

# --- Redis (rate limiting + refresh-token rotation) ---
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- LLM (generation only) ---
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest

# --- Local embeddings (SentenceTransformers, runs on CPU, no API key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_data

# --- OCR ---
OCR_ENABLED=true
OCR_LANGUAGES=["en"]
OCR_MIN_TEXT_CHARS_PER_PAGE=20

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
OVER_FETCH_MULTIPLIER=4
SIMILARITY_THRESHOLD=0.3
LEXICAL_WEIGHT=0.2
SEMANTIC_WEIGHT=0.8
DEDUP_SIMILARITY_THRESHOLD=0.92
MAX_CONTEXT_TOKENS=3000

RATE_LIMIT_PER_MINUTE=60
